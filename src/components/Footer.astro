---
import Support from './Support.astro';

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer__inner">
      <p class="footer__line">
        Playgrounds — Interactive algorithm pages by
        {' '}
        <a href="https://github.com/KeeGooRoomiE" target="_blank" rel="noopener noreferrer">@keegooroomie</a>
      </p>

      <!-- Level with the other footer links; the panel itself opens as a modal
           in the top layer, so nothing here reflows when it does. -->
      <Support />

      <p class="footer__line">
        <a href="https://keegooroomie.github.io/cv_hub/en/" target="_blank" rel="noopener noreferrer">Alexander Gusarov</a>
        {' '}© {year} ·{' '}
        <a href="https://github.com/KeeGooRoomiE/playgrounds" target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer__inner {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    width: 100%;
  }
  .footer__line { margin: 0; }
</style>
