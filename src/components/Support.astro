---
// A modal, not an inline disclosure. The trigger sits in the footer as one
// more link among peers, so it never competes with the page — but the panel
// itself opens in the top layer, which sidesteps the two problems an inline
// <details> had here: it reflowed the footer, and since the footer is the last
// thing on the page, expanding pushed the panel below the fold.
//
// Native <dialog> rather than a hand-rolled popup: Esc-to-close, the focus
// trap, the backdrop and top-layer stacking all come for free and behave the
// way people expect.
//
// Addresses are checksum-verified, not pasted on trust: BTC bech32 (hrp `bc`),
// TRON base58check (prefix 0x41), ETH EIP-55 mixed-case. A typo here silently
// sends money nowhere.
const WALLETS = [
  {
    label: 'Bitcoin',
    short: 'BTC',
    address: 'bc1qpnfut422rr4w77y33h9gmc2jlcmllpdz0wp6nj',
    explorer: 'https://blockstream.info/address/bc1qpnfut422rr4w77y33h9gmc2jlcmllpdz0wp6nj',
  },
  {
    label: 'Ethereum',
    short: 'ETH',
    address: '0xC99B66E5Cb46A05Ea997B0847a1ec50Df7fe8976',
    explorer: 'https://etherscan.io/address/0xC99B66E5Cb46A05Ea997B0847a1ec50Df7fe8976',
  },
  {
    // Same address takes native TRX and TRC-20 USDT. Spelled out because
    // sending USDT on the wrong network is the usual way to lose it.
    label: 'Tron — TRX and USDT (TRC-20)',
    short: 'TRX / USDT',
    address: 'TNdpADBLtAXE26L9W2j7qLmkzUwEt2nWvq',
    explorer: 'https://tronscan.org/#/address/TNdpADBLtAXE26L9W2j7qLmkzUwEt2nWvq',
  },
];
---

<button type="button" class="support__trigger" id="support-open">💛 Support this project</button>

<dialog class="support__dialog" id="support-dialog" aria-labelledby="support-title">
  <div class="support__head">
    <h2 class="support__title" id="support-title">Support this project</h2>
    <button type="button" class="support__close" id="support-close" aria-label="Close">✕</button>
  </div>

  <p class="support__intro">
    Everything here is free and always will be. If a playground taught you
    something, this keeps the next one coming.
  </p>

  <ul class="support__wallets">
    {WALLETS.map((w) => (
      <li class="support__wallet">
        <div class="support__meta">
          <span class="support__short">{w.short}</span>
          <a href={w.explorer} target="_blank" rel="noopener noreferrer">{w.label}</a>
        </div>
        <div class="support__row">
          <code class="support__addr">{w.address}</code>
          <button type="button" class="support__copy" data-address={w.address}>Copy</button>
        </div>
      </li>
    ))}
  </ul>
</dialog>

<style>
  /* Styled to sit level with the footer's other links rather than as a button. */
  .support__trigger {
    width: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 500;
    color: var(--accent);
    cursor: pointer;
  }
  .support__trigger:hover { text-decoration: underline; background: none; }

  .support__dialog {
    /* global.css resets `* { margin: 0 }`, which clobbers the UA's own
       `margin: auto` on <dialog> — without this the modal pins to the
       top-left corner instead of centring. */
    margin: auto;
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--card-bg);
    color: var(--text);
    text-align: left;
    font-size: 13px;
  }
  .support__dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }

  .support__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .support__title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-strong);
  }
  .support__close {
    width: auto;
    margin: 0;
    padding: 2px 6px;
    border: 0;
    background: none;
    font-size: 15px;
    line-height: 1;
    color: var(--muted-2);
    cursor: pointer;
  }
  .support__close:hover { color: var(--text); background: none; }

  .support__intro {
    margin: 0 0 16px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
  }

  .support__wallets { list-style: none; margin: 0; padding: 0; }
  .support__wallet { margin: 0 0 14px; }
  .support__wallet:last-child { margin-bottom: 0; }

  .support__meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }
  .support__short {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--muted-2);
  }
  .support__meta a { font-size: 12px; color: var(--muted); font-weight: 400; }
  .support__meta a:hover { color: var(--accent); }

  .support__row { display: flex; align-items: stretch; gap: 8px; }

  .support__addr {
    flex: 1;
    min-width: 0;
    /* Stays fully readable and selectable — truncating an address invites
       someone copying a partial string by hand. */
    overflow-x: auto;
    white-space: nowrap;
    background: var(--code-bg);
    color: var(--text);
    padding: 7px 9px;
    border-radius: var(--r-sm);
    font-size: 11.5px;
    line-height: 1.4;
  }

  .support__copy {
    flex: 0 0 auto;
    width: auto;
    margin: 0;
    padding: 6px 12px;
    font-size: 11px;
  }
  .support__copy[data-copied] { border-color: #22c55e; color: #22c55e; }

  @media (max-width: 560px) {
    .support__row { flex-direction: column; }
    .support__copy { width: 100%; }
  }
</style>

<script>
  const dialog = document.getElementById('support-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('support-open');
  const closeBtn = document.getElementById('support-close');

  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());

  // A click on the backdrop is reported against the dialog element itself, so
  // comparing the target is what distinguishes "outside" from "on the card".
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.querySelectorAll<HTMLButtonElement>('.support__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const address = btn.dataset.address;
      if (!address) return;

      try {
        await navigator.clipboard.writeText(address);
        btn.textContent = 'Copied';
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.textContent = 'Copy';
          delete btn.dataset.copied;
        }, 1600);
      } catch {
        // Clipboard access needs a secure context and can still be refused; if
        // it is, select the address so it's one keystroke away rather than
        // failing silently.
        const code = btn.previousElementSibling;
        if (code) {
          const range = document.createRange();
          range.selectNodeContents(code);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        btn.textContent = 'Select & copy';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2200);
      }
    });
  });
</script>
