---
---
<div class="playground">
  <div class="controls">
    <div class="control-group">
      <label for="ls-axiom">Axiom (start)</label>
      <input type="text" id="ls-axiom" value="F" placeholder="F" />
    </div>
    <div class="control-group">
      <label for="ls-rule">Rule (F →)</label>
      <input type="text" id="ls-rule" value="F[+F]F[-F]F" placeholder="F[+F]F[-F]F" />
    </div>

    <div class="info-box">
      <strong>Symbols:</strong><br />
      <code>F</code> draw forward<br />
      <code>+</code> turn right<br />
      <code>-</code> turn left<br />
      <code>[</code> save position<br />
      <code>]</code> restore position
    </div>

    <div class="control-group">
      <div class="range-value">
        <span class="range-label">Angle</span>
        <span class="range-number" id="ls-angle-val">25°</span>
      </div>
      <input type="range" id="ls-angle" min="5" max="90" value="25" step="1" />
    </div>
    <div class="control-group">
      <div class="range-value">
        <span class="range-label">Iterations</span>
        <span class="range-number" id="ls-iter-val">4</span>
      </div>
      <input type="range" id="ls-iterations" min="1" max="7" value="4" step="1" />
    </div>

    <div style="display:flex; gap:8px;">
      <button type="button" id="ls-generate" style="flex:1;">🔄 Generate</button>
      <button type="button" id="ls-randomize" style="flex:1;">🎲 Random</button>
    </div>

    <div class="control-group">
      <div class="ctrl-label">Examples</div>
      <div class="ls-presets-grid">
        <button type="button" class="ls-preset-btn" data-preset="0">Tree</button>
        <button type="button" class="ls-preset-btn" data-preset="1">Fern</button>
        <button type="button" class="ls-preset-btn" data-preset="2">Bush</button>
        <button type="button" class="ls-preset-btn" data-preset="3">Algae</button>
        <button type="button" class="ls-preset-btn" data-preset="4">Fractal</button>
      </div>
    </div>
  </div>
  <div class="canvas-wrap">
    <canvas id="ls-canvas"></canvas>
  </div>
</div>

<style>
  .ls-presets-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ls-preset-btn { font-size: 11px; padding: 8px; margin-bottom: 0; }
</style>

<script>
  const canvas = document.getElementById('ls-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resizeCanvas() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }
  window.addEventListener('resize', () => { resizeCanvas(); generate(); });
  resizeCanvas();

  const axiomInput = document.getElementById('ls-axiom') as HTMLInputElement;
  const ruleInput = document.getElementById('ls-rule') as HTMLInputElement;
  const angleInput = document.getElementById('ls-angle') as HTMLInputElement;
  const angleVal = document.getElementById('ls-angle-val')!;
  const iterInput = document.getElementById('ls-iterations') as HTMLInputElement;
  const iterVal = document.getElementById('ls-iter-val')!;

  const presets = [
    { axiom: 'F', rule: 'F[+F]F[-F]F', angle: 25 },
    { axiom: 'F', rule: 'F[+F][--F][-F]', angle: 25 },
    { axiom: 'F', rule: 'F[+F][-F]F[-F][+F]F', angle: 20 },
    { axiom: 'A', rule: 'AB', angle: 25 },
    { axiom: 'F', rule: 'F[+F]F[-F][F]', angle: 22 },
  ];

  interface StackFrame { x: number; y: number; angle: number; depth: number; }

  class LSystem {
    axiom: string;
    rule: string;
    angle: number;
    current: string;

    constructor(axiom: string, rule: string, angleDeg: number) {
      this.axiom = axiom;
      this.rule = rule;
      this.angle = (angleDeg * Math.PI) / 180;
      this.current = axiom;
    }

    iterate(times: number) {
      this.current = this.axiom;
      for (let i = 0; i < times; i++) {
        let next = '';
        for (const char of this.current) {
          next += char === 'F' || char === 'A' ? this.rule : char;
        }
        this.current = next;
        if (this.current.length > 50000) break;
      }
    }

    draw(context: CanvasRenderingContext2D, startX: number, startY: number, startAngle: number, length: number) {
      let x = startX, y = startY, angle = startAngle;
      const stack: StackFrame[] = [];
      let depth = 0;

      context.strokeStyle = 'hsl(30, 60%, 35%)';
      context.lineWidth = 2;
      context.lineCap = 'round';
      context.lineJoin = 'round';

      for (const char of this.current) {
        if (char === 'F' || char === 'A') {
          const lw = Math.max(0.5, 2 - depth * 0.15);
          context.lineWidth = lw;
          context.strokeStyle = `hsl(30, ${60 - depth * 3}%, ${35 - depth * 3}%)`;

          const nx = x + length * Math.cos(angle);
          const ny = y + length * Math.sin(angle);
          context.beginPath();
          context.moveTo(x, y);
          context.lineTo(nx, ny);
          context.stroke();
          x = nx;
          y = ny;
        } else if (char === '+') {
          angle += this.angle;
        } else if (char === '-') {
          angle -= this.angle;
        } else if (char === '[') {
          stack.push({ x, y, angle, depth });
          depth++;
        } else if (char === ']') {
          const s = stack.pop();
          if (s) { x = s.x; y = s.y; angle = s.angle; depth = s.depth; }
        }
      }
    }
  }

  let system: LSystem | undefined;

  function generate() {
    const axiom = axiomInput.value;
    const rule = ruleInput.value;
    const angle = parseInt(angleInput.value);
    const iterations = parseInt(iterInput.value);

    system = new LSystem(axiom, rule, angle);
    system.iterate(iterations);
    draw();
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (!system) return;

    const width = canvas.width / window.devicePixelRatio;
    const height = canvas.height / window.devicePixelRatio;
    const startX = width / 2;
    const startY = height * 0.9;
    const startAngle = -Math.PI / 2;
    const length = (Math.min(width, height) * 0.06) / Math.pow(1.3, parseInt(iterInput.value));

    system.draw(ctx, startX, startY, startAngle, length);
  }

  function loadPreset(idx: number) {
    const p = presets[idx];
    axiomInput.value = p.axiom;
    ruleInput.value = p.rule;
    angleInput.value = String(p.angle);
    angleVal.textContent = `${p.angle}°`;
    generate();
  }

  function randomize() {
    const axioms = ['F', 'A'];
    const ruleOptions = [
      'F[+F]F[-F]F',
      'F[+F][--F][-F]',
      'F[+F][-F]F[-F][+F]F',
      'F[+F]F[-F][F]',
      'F[++F][--F]',
      'F[-F]F[+F]F',
    ];
    const angles = [15, 18, 20, 22, 25, 28, 30, 35, 40];

    axiomInput.value = axioms[Math.floor(Math.random() * axioms.length)];
    ruleInput.value = ruleOptions[Math.floor(Math.random() * ruleOptions.length)];
    const angle = angles[Math.floor(Math.random() * angles.length)];
    const iterations = Math.floor(Math.random() * 4) + 2;

    angleInput.value = String(angle);
    angleVal.textContent = `${angle}°`;
    iterInput.value = String(iterations);
    iterVal.textContent = String(iterations);

    generate();
  }

  document.getElementById('ls-generate')!.addEventListener('click', generate);
  document.getElementById('ls-randomize')!.addEventListener('click', randomize);
  document.querySelectorAll<HTMLButtonElement>('.ls-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => loadPreset(parseInt(btn.dataset.preset!)));
  });

  angleInput.addEventListener('input', () => { angleVal.textContent = `${angleInput.value}°`; });
  iterInput.addEventListener('input', () => { iterVal.textContent = iterInput.value; });

  generate();
</script>
