---
---
<div class="playground">
  <div class="controls">
    <div class="control-group">
      <div class="control-label">Seed</div>
      <input type="text" id="pn-seed" value="42" placeholder="e.g., 42, minecraft" />
    </div>
    <button type="button" id="pn-random-seed" class="full-width">🎲 Random Seed</button>
    <div class="control-group">
      <div class="range-value">
        <span class="range-label">Octaves</span>
        <span class="range-number" id="pn-octaves-val">3</span>
      </div>
      <input type="range" id="pn-octaves" min="1" max="5" value="3" step="1" />
    </div>
    <div class="control-group">
      <div class="range-value">
        <span class="range-label">Scale</span>
        <span class="range-number" id="pn-scale-val">30</span>
      </div>
      <input type="range" id="pn-scale" min="5" max="50" value="30" step="1" />
    </div>
    <div class="control-group">
      <div class="control-label">Palette</div>
      <select id="pn-palette">
        <option value="monochrome">Monochrome</option>
        <option value="minecraft">Minecraft</option>
        <option value="gradient">Gradient</option>
        <option value="random">Random</option>
      </select>
    </div>
    <div class="control-group">
      <div class="range-value">
        <span class="range-label">Amplitude <span style="color:var(--muted);font-weight:400">(3D only)</span></span>
        <span class="range-number" id="pn-amplitude-val">10</span>
      </div>
      <input type="range" id="pn-amplitude" min="0" max="50" value="10" step="1" />
    </div>
  </div>
  <div class="canvas-container pn-canvas-container">
    <div class="canvas-header">
      <span class="view-label" id="pn-view-label">2D View</span>
      <button type="button" id="pn-toggle-view" style="width: 120px; padding: 6px; margin: 0;">Switch to 3D</button>
    </div>
    <canvas id="pn-canvas"></canvas>
  </div>
</div>

<style>
  /* .canvas-container (global.css) covers background/border/radius/overflow; only the flex layout for the 2D/3D header is added here. */
  .pn-canvas-container {
    display: flex;
    flex-direction: column;
  }
  .canvas-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px 0; margin-bottom: 12px; }
  .view-label { font-size: 12px; color: var(--muted); font-weight: 500; }
  #pn-canvas { width: 100%; height: 600px; border-radius: 4px; background: #fff; }
</style>

<script>
  import { getSeedParam, isThumbnailMode } from '../lib/seed';

  const canvas = document.getElementById('pn-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  let is3D = false;
  let noiseGrid: number[] = [];
  let gridWidth = 0;
  let gridHeight = 0;

  const seedInput = document.getElementById('pn-seed') as HTMLInputElement;
  const octavesInput = document.getElementById('pn-octaves') as HTMLInputElement;
  const octavesVal = document.getElementById('pn-octaves-val')!;
  const scaleInput = document.getElementById('pn-scale') as HTMLInputElement;
  const scaleVal = document.getElementById('pn-scale-val')!;
  const paletteSelect = document.getElementById('pn-palette') as HTMLSelectElement;
  const amplitudeInput = document.getElementById('pn-amplitude') as HTMLInputElement;
  const amplitudeVal = document.getElementById('pn-amplitude-val')!;
  const viewLabel = document.getElementById('pn-view-label')!;
  const toggleViewBtn = document.getElementById('pn-toggle-view') as HTMLButtonElement;
  const randomSeedBtn = document.getElementById('pn-random-seed') as HTMLButtonElement;

  function resizeCanvas() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }

  window.addEventListener('resize', () => { resizeCanvas(); generateNoise(); });
  resizeCanvas();

  function seededRandom(seed: number) { const x = Math.sin(seed) * 10000; return x - Math.floor(x); }

  function perlinNoise(x: number, y: number, seed: number) {
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
    const hash = (i: number, j: number) => seededRandom((i * 73856093) ^ (j * 19349663) ^ seed);
    const n00 = hash(xi, yi), n10 = hash(xi + 1, yi), n01 = hash(xi, yi + 1), n11 = hash(xi + 1, yi + 1);
    const nx0 = n00 * (1 - u) + n10 * u, nx1 = n01 * (1 - u) + n11 * u;
    return nx0 * (1 - v) + nx1 * v;
  }

  function lerp(a: number, b: number, t: number) { return a * (1 - t) + b * t; }

  function hslToRgb(h: number, s: number, l: number): [number, number, number] {
    s /= 100; l /= 100;
    const k = (n: number) => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    return [Math.round(255 * f(0)), Math.round(255 * f(8)), Math.round(255 * f(4))];
  }

  function lerpColor(c1: number[], c2: number[], t: number): [number, number, number] {
    return [Math.floor(lerp(c1[0], c2[0], t)), Math.floor(lerp(c1[1], c2[1], t)), Math.floor(lerp(c1[2], c2[2], t))];
  }

  function getColor(value: number, palette: string): [number, number, number] {
    if (palette === 'minecraft') {
      const colors = [[30, 90, 150], [100, 150, 200], [150, 120, 80], [80, 140, 60], [120, 120, 120]];
      if (value < 0.3) return lerpColor(colors[0], colors[1], value / 0.3);
      else if (value < 0.4) return lerpColor(colors[1], colors[2], (value - 0.3) / 0.1);
      else if (value < 0.6) return lerpColor(colors[2], colors[3], (value - 0.4) / 0.2);
      else return lerpColor(colors[3], colors[4], (value - 0.6) / 0.4);
    } else if (palette === 'gradient') {
      return lerpColor([0, 100, 200], [200, 100, 0], value);
    } else if (palette === 'random') {
      return hslToRgb(value * 360, 70, 50);
    }
    const gray = Math.floor(value * 255);
    return [gray, gray, gray];
  }

  function generateNoise() {
    const seed = seedInput.value;
    const octaves = parseInt(octavesInput.value);
    const scale = parseInt(scaleInput.value);
    const seedHash = seed.split('').reduce((a, b) => { a = ((a << 5) - a) + b.charCodeAt(0); return a & a; }, 0);

    gridWidth = 128;
    gridHeight = 128;
    noiseGrid = [];

    for (let y = 0; y < gridHeight; y++) {
      for (let x = 0; x < gridWidth; x++) {
        let value = 0, amplitude = 1, frequency = 1, maxValue = 0;
        for (let oct = 0; oct < octaves; oct++) {
          value += perlinNoise((x / scale) * frequency, (y / scale) * frequency, seedHash + oct) * amplitude;
          maxValue += amplitude;
          amplitude *= 0.5;
          frequency *= 2;
        }
        noiseGrid.push(Math.max(0, Math.min(1, value / maxValue)));
      }
    }

    if (is3D) render3D(); else render2D();
  }

  function render2D() {
    const palette = paletteSelect.value;
    const width = canvas.getBoundingClientRect().width;
    const height = canvas.getBoundingClientRect().height;

    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, width, height);

    // Interactive view leaves a margin so the texture doesn't touch the
    // frame; the thumbnail wants the opposite — fill edge-to-edge along the
    // larger side so the card placeholder has no empty bars, cropping the
    // other axis if needed.
    const maxSize = isThumbnailMode() ? Math.max(width, height) : Math.min(width, height) * 0.85;
    const scale = maxSize / Math.max(gridWidth, gridHeight);
    const offsetX = (width - gridWidth * scale) / 2;
    const offsetY = (height - gridHeight * scale) / 2;

    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = gridWidth;
    tempCanvas.height = gridHeight;
    const tempCtx = tempCanvas.getContext('2d')!;
    const imageData = tempCtx.createImageData(gridWidth, gridHeight);
    const data = imageData.data;

    for (let i = 0; i < noiseGrid.length; i++) {
      const rgb = getColor(noiseGrid[i], palette);
      data[i * 4] = rgb[0]; data[i * 4 + 1] = rgb[1]; data[i * 4 + 2] = rgb[2]; data[i * 4 + 3] = 255;
    }

    tempCtx.putImageData(imageData, 0, 0);
    ctx.drawImage(tempCanvas, offsetX, offsetY, gridWidth * scale, gridHeight * scale);
  }

  function render3D() {
    const palette = paletteSelect.value;
    const width = canvas.getBoundingClientRect().width;
    const height = canvas.getBoundingClientRect().height;
    const amplitudeValue = parseInt(amplitudeInput.value);

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, width, height);

    const step = 4;
    const angle = Math.PI / 6;
    const cosA = Math.cos(angle);
    const sinA = Math.sin(angle);
    // Interactive default is a fixed, comfortable size. The thumbnail wants
    // the isometric terrain to fill the frame instead — same "cover" idea as
    // render2D's fill, just solved for the scale that makes the diamond's
    // bounding box match the canvas along its more constraining axis.
    const baseFlatW = (gridWidth + gridHeight) * cosA;
    const baseFlatH = (gridWidth + gridHeight) * sinA;
    const scale = isThumbnailMode() ? Math.max(width / baseFlatW, height / baseFlatH) * 0.92 : 2;

    const isoX = (x: number, y: number) => (x - y) * cosA * scale;
    const isoY = (x: number, y: number, z: number) => (x + y) * sinA * scale - z;

    const getZ = (gx: number, gy: number) => {
      const idx = Math.min(gy * gridWidth + gx, noiseGrid.length - 1);
      return noiseGrid[idx] * amplitudeValue;
    };

    const flatW = (gridWidth + gridHeight) * cosA * scale;
    const flatH = (gridWidth + gridHeight) * sinA * scale;
    const offsetX = (width - flatW) / 2 + gridHeight * cosA * scale;
    const offsetY = (height - flatH) / 2 + amplitudeValue;

    for (let gy = 0; gy < gridHeight - step; gy += step) {
      for (let gx = 0; gx < gridWidth - step; gx += step) {
        const z00 = getZ(gx, gy);
        const z10 = getZ(gx + step, gy);
        const z01 = getZ(gx, gy + step);
        const z11 = getZ(gx + step, gy + step);

        const x0 = isoX(gx, gy) + offsetX;
        const x1 = isoX(gx + step, gy) + offsetX;
        const x2 = isoX(gx + step, gy + step) + offsetX;
        const x3 = isoX(gx, gy + step) + offsetX;

        const y0 = isoY(gx, gy, z00) + offsetY;
        const y1 = isoY(gx + step, gy, z10) + offsetY;
        const y2 = isoY(gx + step, gy + step, z11) + offsetY;
        const y3 = isoY(gx, gy + step, z01) + offsetY;

        const cx = Math.min(Math.round(gx + step / 2), gridWidth - 1);
        const cy = Math.min(Math.round(gy + step / 2), gridHeight - 1);
        const val = noiseGrid[cy * gridWidth + cx];
        const rgb = getColor(val, palette);

        ctx.beginPath();
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.lineTo(x3, y3);
        ctx.closePath();
        ctx.fillStyle = `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
        ctx.fill();
      }
    }
  }

  octavesInput.addEventListener('input', () => { octavesVal.textContent = octavesInput.value; generateNoise(); });
  scaleInput.addEventListener('input', () => { scaleVal.textContent = scaleInput.value; generateNoise(); });
  paletteSelect.addEventListener('change', generateNoise);
  amplitudeInput.addEventListener('input', () => {
    amplitudeVal.textContent = amplitudeInput.value;
    if (is3D) render3D();
  });
  seedInput.addEventListener('input', generateNoise);
  randomSeedBtn.addEventListener('click', () => {
    seedInput.value = Math.random().toString(36).substring(7);
    generateNoise();
  });
  toggleViewBtn.addEventListener('click', () => {
    is3D = !is3D;
    viewLabel.textContent = is3D ? '3D View' : '2D View';
    toggleViewBtn.textContent = is3D ? 'Switch to 2D' : 'Switch to 3D';
    generateNoise();
  });

  // Same override idiom as the seed: a thumbnailQuery like
  // "view=3d&palette=random&scale=33&amplitude=50" (see docs/CONTENT_GUIDE.md)
  // can push this into a specific state before the capture screenshot.
  // Harmless no-op for a normal visitor — these params are never set otherwise.
  const urlParams = new URLSearchParams(location.search);

  const urlSeed = getSeedParam();
  if (urlSeed) seedInput.value = urlSeed;

  if (urlParams.get('view') === '3d') {
    is3D = true;
    viewLabel.textContent = '3D View';
    toggleViewBtn.textContent = 'Switch to 2D';
  }
  const urlPalette = urlParams.get('palette');
  if (urlPalette) paletteSelect.value = urlPalette;
  const urlOctaves = urlParams.get('octaves');
  if (urlOctaves) { octavesInput.value = urlOctaves; octavesVal.textContent = urlOctaves; }
  const urlScale = urlParams.get('scale');
  if (urlScale) { scaleInput.value = urlScale; scaleVal.textContent = urlScale; }
  const urlAmplitude = urlParams.get('amplitude');
  if (urlAmplitude) { amplitudeInput.value = urlAmplitude; amplitudeVal.textContent = urlAmplitude; }

  generateNoise();
</script>
