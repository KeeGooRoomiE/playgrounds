# Local production-build testing only — nothing here is required for `npm run dev`.
#
# GITHUB_REPOSITORY mirrors what GitHub Actions sets automatically in CI.
# Export it locally to reproduce the real site/base path (see astro.config.mjs):
#   GITHUB_REPOSITORY=KeeGooRoomiE/<repo-name> npx astro build
GITHUB_REPOSITORY=

# The optional Telegram deploy-notification job in .github/workflows/deploy.yml
# reads PIPLINE_BOT_SECRET and CHAT_ID from GitHub repo Settings → Secrets →
# Actions, NOT from this file — listed here only for reference.
